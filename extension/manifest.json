{
  "manifest_version": 3,
  "name": "StudyOS Coursera Tracker",
  "version": "1.0",
  "description": "Reads only video titles and durations from your open Coursera module pages for study planning in StudyOS. Never touches video content, never asks for your password, nothing leaves your browser.",
  "permissions": ["storage", "activeTab", "scripting", "clipboardWrite"],
  "host_permissions": [
    "https://www.coursera.org/*",
    "https://rashmivemuri.github.io/*",
    "http://localhost:*/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.coursera.org/*"],
      "js": ["content-coursera.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://rashmivemuri.github.io/study-os/*", "http://localhost:*/*"],
      "js": ["content-studyos.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Send to StudyOS" }
}
